{
  "schema_version": 1,
  "purpose": "Machine-checkable inventory of the PE32/PE32+ structures a user-mode loader must consume. Field offsets are relative to the start of each structure. Every entry cites the document it came from; where the Microsoft PE specification is silent or ambiguous the entry says so.",
  "sources": {
    "ms-pe": {
      "title": "Microsoft PE and COFF Specification",
      "url": "https://learn.microsoft.com/en-us/windows/win32/debug/pe-format",
      "retrieved": "2026-11-23",
      "caveat": "The document states it 'is not guaranteed to be a complete specification in all respects'."
    },
    "ms-x64-unwind": {
      "title": "Unwind data structures for x64 exception handling",
      "url": "https://learn.microsoft.com/en-us/cpp/build/exception-handling-x64",
      "retrieved": "2026-11-23"
    },
    "ecma-335": {
      "title": "ECMA-335 Common Language Infrastructure, partition II section 25 (CLR header)",
      "url": "https://ecma-international.org/publications-and-standards/standards/ecma-335/",
      "retrieved": "2026-11-23",
      "caveat": "The PE specification only defines the object-file .cormeta section and points the CLR Runtime Header data directory at it; the image-level COR20 layout is specified by ECMA-335."
    },
    "winnt-h": {
      "title": "Windows SDK winnt.h (IMAGE_LOAD_CONFIG_DIRECTORY64 and related definitions)",
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/winnt/",
      "retrieved": "2026-11-23",
      "caveat": "Header values are treated as the implementation reference where the prose specification is incomplete; discrepancies are listed in docs/01-pe-loader-requirements.md."
    }
  },
  "structures": [
