      "name": "IMAGE_DOS_HEADER",
      "kind": "fixed",
      "size": 64,
      "source": "ms-pe",
      "anchor": "MS-DOS stub",
      "loader_role": "Locate the PE signature; e_magic must be 0x5A4D and e_lfanew must be a file offset that holds 'PE\\0\\0'.",
      "fields": [
        {
          "offset": 0,
          "size": 2,
          "name": "e_magic",
          "note": "0x5A4D ('MZ')"
        },
        {
          "offset": 2,
          "size": 58,
          "name": "e_cblp..e_res2",
          "note": "Not used by the loader; kept as one span to keep the table short."
        },
        {
          "offset": 60,
          "size": 4,
          "name": "e_lfanew",
          "note": "File offset of the PE signature."
        }
      ]
    },
